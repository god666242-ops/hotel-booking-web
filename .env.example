# Resend (lead notification emails)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
CONTACT_FROM_EMAIL=PureBook <leads@purebook.in>
CONTACT_TO_EMAIL=sales@purebook.in

# Optional: also POST every lead as JSON to a webhook (Slack, Zapier, CRM...)
CONTACT_WEBHOOK_URL=

# Public links
NEXT_PUBLIC_APP_URL=https://app.purebook.in

# Live widget demo (the widget dev/preview server in mock mode, shown in an iframe)
NEXT_PUBLIC_WIDGET_DEMO_URL=http://localhost:3001/?mock

# Script shown in the embed snippet. Dev server serves /src/main.js (type=module);
# the production build (vite build) outputs engine.js (IIFE).
NEXT_PUBLIC_EMBED_SRC=https://cdn.purebook.in/engine.js
